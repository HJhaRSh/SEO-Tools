# Vercel Frontend Environment Variables
# In production, set this to your hosted backend URL (e.g. Render, Railway, Fly.io):
BACKEND_URL=https://your-backend.onrender.com

# In local development:
# BACKEND_URL=http://localhost:5000

# Tool #18: AI Page Focus & Semantic Relevance Analyzer
# Gemini API Key (obtain free from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional AI Provider selection (default: gemini)
PAGE_FOCUS_AI_PROVIDER=gemini

# Optional Cloudflare Workers AI Fallback (Free Tier eligible)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# Configurable Rate Limits (per IP) and Global Budget
PAGE_FOCUS_RATE_LIMIT_PER_MINUTE=5
PAGE_FOCUS_RATE_LIMIT_PER_DAY=15
PAGE_FOCUS_GLOBAL_DAILY_BUDGET=20

# Optional Distributed Rate Limiting & Quota Enforcement via Upstash Redis (100% Free Tier REST)
# Set these if running across multiple serverless instances (e.g. Vercel) to share quota limits:
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
# Set to true only if you want production to hard-block / fail-closed when Redis is unconfigured or unreachable:
# PAGE_FOCUS_ENFORCE_DISTRIBUTED_QUOTA=false
