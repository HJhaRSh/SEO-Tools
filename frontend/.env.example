# Vercel Frontend Environment Variables
# In production, set this to your hosted backend URL (e.g. Render, Railway, Fly.io):
BACKEND_URL=https://your-backend.onrender.com

# In local development:
# BACKEND_URL=http://localhost:5000

# =====================================================================
# Tool #18: AI Page Focus & Semantic Relevance Analyzer
# =====================================================================
# Dedicated Gemini API Key (obtain free from Google AI Studio: https://aistudio.google.com/apikey)
# NOTE: GEMINI_API_KEY is isolated strictly to Tool #18 and never overwrites GOOGLE_API_KEY (used by Knowledge Graph tool).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Strategy: 1 Primary Model + 1 Verified Fallback
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional AI Provider selection ('gemini' | 'cloudflare')
PAGE_FOCUS_AI_PROVIDER=gemini

# Optional Cloudflare Workers AI Fallback (Free Tier eligible: @cf/meta/llama-3.1-8b-instruct)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Configurable Rate Limits (per IP) and Global AI Quota Budgets
# Resets at 00:00:00 UTC (note: Google upstream AI Studio free quota resets at midnight US Pacific / 08:00:00 UTC)
PAGE_FOCUS_RATE_LIMIT_PER_MINUTE=5
PAGE_FOCUS_RATE_LIMIT_PER_DAY=15
PAGE_FOCUS_GLOBAL_DAILY_BUDGET=20
PAGE_FOCUS_GLOBAL_EMBEDDING_BUDGET=500

# Distributed Rate Limiting & Quota Enforcement via Upstash Redis (100% Free Tier REST)
# Required in production multi-instance serverless deployments (e.g. Vercel) for atomic check-and-reserve Lua quota tracking:
# In production (NODE_ENV=production), system fails closed if Redis is unconfigured or unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PAGE_FOCUS_FAIL_CLOSED=false

# Administrative Secret (used to authorize live health probes ?live=true on /api/seo/page-focus/health)
ADMIN_SECRET=
