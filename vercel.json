{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/seo/review-link/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/serp-simulator/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/knowledge-graph/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/hreflang/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/mobile-friendly/render",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/mobile-friendly/test",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/mobile-first-index/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/prerendering/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/robots/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/sitemap/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/ai-bot-access/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/htaccess/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/fetch-render/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/schema-checker/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/seo/domain-age/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
